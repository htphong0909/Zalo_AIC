+def trim_waveform_silence(
+    waveform: np.ndarray,
+    sr: int = 16000,
+    frame_ms: float = 25.0,
+    hop_ms: float = 10.0,
+    db_threshold: float = -35.0,
+    margin_ms: float = 150.0,
+) -> np.ndarray:
+    """Conservative energy-based boundary silence trimming with safety collar.
+
+    Detects leading and trailing silence regions below db_threshold relative to peak frame RMS,
+    retaining a margin_ms buffer so low-energy consonants and offsets are never truncated.
+    """
+    if len(waveform) == 0:
+        return waveform
+
+    frame_len = int(round((frame_ms / 1000.0) * sr))
+    hop_len = int(round((hop_ms / 1000.0) * sr))
+    margin_len = int(round((margin_ms / 1000.0) * sr))
+
+    num_frames = 1 + (len(waveform) - frame_len) // hop_len
+    if num_frames <= 0:
+        return waveform
+
+    shape = (num_frames, frame_len)
+    strides = (waveform.strides[0] * hop_len, waveform.strides[0])
+    frames = np.lib.stride_tricks.as_strided(waveform, shape=shape, strides=strides)
+    rms = np.sqrt(np.mean(frames ** 2, axis=1) + 1e-12)
+
+    peak_rms = float(np.max(rms))
+    if peak_rms < 1e-5:
+        return waveform
+
+    rms_db = 20.0 * np.log10(rms / peak_rms)
+    active = np.where(rms_db > db_threshold)[0]
+    if len(active) == 0:
+        return waveform
+
+    start_idx = max(0, active[0] * hop_len - margin_len)
+    end_idx = min(len(waveform), (active[-1] * hop_len + frame_len) + margin_len)
+    return waveform[start_idx:end_idx]
+
+
+def preprocess_waveform(
+    waveform: np.ndarray,
+    sr: int = 16000,
+    *,
+    trim_silence: bool = True,
+    vad_db_threshold: float = -35.0,
+    vad_margin_ms: float = 150.0,
+    peak_normalize: bool = True,
+    pre_roll_pad_ms: float = 80.0,
+    post_roll_pad_ms: float = 80.0,
+) -> np.ndarray:
+    """Preprocesses raw audio waveform for Whisper ASR inference.
+
+    Pipeline:
+    1. Conservative boundary silence trimming (VAD) with safety margin.
+    2. Peak amplitude normalization to 0.95 for Mel filterbank dynamic headroom.
+    3. Symmetric bilateral collar padding (80.0 ms = 4 downsampled encoder frames >= 65 ms receptive field).
+    """
+    if len(waveform) == 0:
+        return waveform
+
+    # 1. Conservative energy-based silence trimming before peak normalization
+    if trim_silence:
+        waveform = trim_waveform_silence(
+            waveform,
+            sr=sr,
+            db_threshold=vad_db_threshold,
+            margin_ms=vad_margin_ms,
+        )
+
+    # 2. Peak amplitude normalization to 0.95 to optimize Mel filterbank dynamic headroom
+    if peak_normalize:
+        peak = float(np.max(np.abs(waveform)))
+        if peak > 1e-4:
+            waveform = waveform * (0.95 / peak)
+
+    # 3. Symmetric bilateral collar padding
+    if pre_roll_pad_ms > 0 or post_roll_pad_ms > 0:
+        pad_pre = int(round((pre_roll_pad_ms / 1000.0) * sr)) if pre_roll_pad_ms > 0 else 0
+        pad_post = int(round((post_roll_pad_ms / 1000.0) * sr)) if post_roll_pad_ms > 0 else 0
+        if pad_pre > 0 or pad_post > 0:
+            waveform = np.pad(waveform, (pad_pre, pad_post), mode="constant", constant_values=0.0)
+    return waveform
+
+
