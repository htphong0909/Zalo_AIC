+
+                    clean_text = inverse_text_normalize(clean_text)
+
+                results.append(
+                    ASRResult(
+                        text=clean_text,
+                        raw_text=raw_text,
+                        latency_s=avg_lat,
+                    )
+                )
+
+        return results
