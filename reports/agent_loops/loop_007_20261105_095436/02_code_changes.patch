+
+            first_ctx = chunk_contexts[0] if chunk_contexts else None
+            same_context = all(c == first_ctx for c in chunk_contexts)
+            gen_kwargs = self._build_gen_kwargs(first_ctx if same_context else None)
+
+            with torch.inference_mode():
+                predicted_ids = self.model.generate(input_features, **gen_kwargs)
+
+            raw_texts = self.processor.batch_decode(predicted_ids, skip_special_tokens=True)
+            elapsed = time.perf_counter() - t0
+            avg_lat = elapsed / len(chunk_paths)
+
+            raw_iter = iter(raw_texts)
+            for w in waveforms:
+                if w is None:
+                    results.append(ASRResult(text="", raw_text="", latency_s=avg_lat))
+                    continue
+                raw_text = next(raw_iter)
+                clean_text = _sanitize_hyp(raw_text, enable_itn=self.enable_itn)
+                results.append(
+                    ASRResult(
+                        text=clean_text,
+                        raw_text=raw_text,
+                        latency_s=avg_lat,
+                    )
+                )
+
+        return results
