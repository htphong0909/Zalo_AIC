 # In standard written Vietnamese, 'gút' is strictly an orthographic error in these contexts.
 _RE_DIALECT_RUT = re.compile(r"\bgút\s+(tiết\s+kiệm|tiền)\b", re.IGNORECASE)
 
+# Loanword solid compound fusion
+# In Vietnamese ASR transcripts and evaluation, foreign loanword compounds are standardized
+# as solid single tokens ('email', 'wifi', 'online', 'offline', 'autopay', 'coworking').
+# Whisper's English subword tokenizer frequently outputs hyphenated or separated tokens
+# ('e-mail', 'e mail', 'wi-fi', 'wi fi', 'on-line', 'on line', 'off-line', 'off line',
+#  'auto-pay', 'auto pay', 'co-working', 'co working').
+_LOANWORD_TARGETS = [
+    (re.compile(r"\be[\s\-]+mail\b", re.IGNORECASE), "email"),
+    (re.compile(r"\bwi[\s\-]+fi\b", re.IGNORECASE), "wifi"),
+    (re.compile(r"\bon[\s\-]+line\b", re.IGNORECASE), "online"),
+    (re.compile(r"\boff[\s\-]+line\b", re.IGNORECASE), "offline"),
+    (re.compile(r"\bauto[\s\-]+pay\b", re.IGNORECASE), "autopay"),
+    (re.compile(r"\bco[\s\-]+working\b", re.IGNORECASE), "coworking"),
+]
+
+
+def _sub_loanword(m: re.Match, target: str) -> str:
+    raw = m.group(0)
+    if raw.isupper():
+        return target.upper()
+    if raw[0].isupper():
+        return target.capitalize()
+    return target.lower()
+
+
+# Ride-hailing vehicular collocation standardization
+# In LifeMate ground-truth transcripts, 'xe bốn chỗ' exclusively takes the written numeral
+# ('bốn') rather than digit '4' ('xe 4 chỗ' -> 'xe bốn chỗ').
+_RE_XE_4_CHO_LOWER = re.compile(r"\bxe\s+4\s+chỗ\b")
+_RE_XE_4_CHO_CAP = re.compile(r"\bXe\s+4\s+chỗ\b")
+
 
