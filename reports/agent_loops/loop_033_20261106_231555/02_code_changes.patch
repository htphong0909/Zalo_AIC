+VI_PARTICLES = {
+    "nhé", "nha", "hen", "ạ", "đi", "cơ", "mà", "thôi", "thay", "nhá", "nè", "nghe"
+}
+
+
+def _normalize_token(w: str) -> str:
+    w = unicodedata.normalize("NFC", w).lower()
+    return re.sub(r"[^\w\s]", "", w).strip()
+
+
+def verify_with_ctc_anchor(whisper_hyp: str, ctc_hyp: str) -> str:
+    """Refines a seq2seq Whisper hypothesis using a monotonic CTC acoustic anchor.
+
+    Addresses:
+    - Particle drift (e.g. 'nha' -> 'nhé') at utterance tails.
+    - Swallowed syllables (e.g. 'bắt bếp' -> 'tắt đèn bếp') by acoustic alignment.
+    - Hallucinated insertions (e.g. 'thu mua' -> 'mua') lacking CTC acoustic evidence.
+    Preserves Whisper's superior casing, punctuation, and contextual formatting.
+    """
+    if not whisper_hyp or not ctc_hyp:
+        return whisper_hyp
+
+    whisper_clean = unicodedata.normalize("NFC", whisper_hyp).strip()
+    ctc_clean = unicodedata.normalize("NFC", ctc_hyp).strip()
+
+    w_words = whisper_clean.split()
+    c_words = ctc_clean.split()
+
+    if not w_words or not c_words:
+        return whisper_clean
+
+    w_norm = [_normalize_token(w) for w in w_words]
+    c_norm = [_normalize_token(w) for w in c_words]
+
+    # Fast path: normalized texts are identical
+    if w_norm == c_norm:
+        return whisper_clean
+
+    matcher = SequenceMatcher(None, w_norm, c_norm)
+    similarity = matcher.ratio()
+
+    # If hypotheses are too dissimilar (< 0.50), trust Whisper's language model
+    if similarity < 0.50:
+        return whisper_clean
+
+    opcodes = matcher.get_opcodes()
+    refined_words = list(w_words)
+
+    for tag, i1, i2, j1, j2 in reversed(opcodes):
+        if tag == "equal":
+            continue
+
+        w_span_norm = w_norm[i1:i2]
+        c_span_norm = c_norm[j1:j2]
+        c_span_raw = c_words[j1:j2]
+
+        # Case 1: Tail particle substitution
+        if i2 == len(w_words) and j2 == len(c_words) and (i2 - i1 == 1) and (j2 - j1 == 1):
+            w_p = w_span_norm[0]
+            c_p = c_span_norm[0]
+            if w_p in VI_PARTICLES or c_p in VI_PARTICLES:
+                orig_w = w_words[i1]
+                punc = ""
+                m = re.search(r"([,.:?!;]+)$", orig_w)
+                if m:
+                    punc = m.group(1)
+                replacement = c_span_raw[0]
+                if orig_w and orig_w[0].isupper():
+                    replacement = replacement.capitalize()
+                refined_words[i1] = replacement + punc
+                continue
+
+        # Case 2: Hallucinated word insertion in Whisper
+        if tag == "delete":
+            prev_match = (i1 > 0)
+            next_match = (i2 < len(w_words))
+            if prev_match and next_match:
+                deleted_punct = ""
+                for dw in w_words[i1:i2]:
+                    m = re.search(r"([,.:?!;]+)$", dw)
+                    if m:
+                        deleted_punct += m.group(1)
+                del refined_words[i1:i2]
+                if deleted_punct and i1 - 1 < len(refined_words):
+                    refined_words[i1 - 1] = refined_words[i1 - 1].rstrip(",.:?!;") + deleted_punct
+                continue
+
+        # Case 3: Swallowed / dropped syllable or substitution
+        if tag == "replace":
+            orig_first = w_words[i1]
+            orig_last = w_words[i2 - 1]
+            punc = ""
+            m = re.search(r"([,.:?!;]+)$", orig_last)
+            if m:
+                punc = m.group(1)
+
+            rep_tokens = []
+            for idx, c_tk in enumerate(c_span_raw):
+                tk = c_tk
+                if idx == 0 and orig_first and orig_first[0].isupper():
+                    tk = tk.capitalize()
+                rep_tokens.append(tk)
+            if punc:
+                rep_tokens[-1] = rep_tokens[-1] + punc
+            refined_words[i1:i2] = rep_tokens
+            continue
+
+        if tag == "insert":
+            rep_tokens = list(c_span_raw)
+            refined_words[i1:i1] = rep_tokens
+            continue
+
+    result = " ".join(refined_words)
+    result = re.sub(r"\s+([,.:?!])", r"\1", result)
+    result = re.sub(r"\s+", " ", result).strip()
+    return result
+
 
