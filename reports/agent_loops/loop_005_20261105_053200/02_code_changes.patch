+
+    def transcribe_batch(
+        self,
+        audio_paths: list[str | Path],
+        *,
+        batch_size: int = 4,
+        extra_context: str | None = None,
+    ) -> list[ASRResult]:
+        import torch
+
+        results: list[ASRResult] = []
+        if not audio_paths:
+            return results
+
+        prompt_text = self.initial_prompt
+        if extra_context:
+            prompt_text = f"{prompt_text} {extra_context}".strip() if prompt_text else extra_context
+
+        prompt_tensor = None
+        if prompt_text and hasattr(self.processor, "get_prompt_ids"):
+            try:
+                p_ids = self.processor.get_prompt_ids(prompt_text[:350])
+                if not isinstance(p_ids, torch.Tensor):
+                    prompt_tensor = torch.tensor(p_ids, device=self.device)
+                else:
+                    prompt_tensor = p_ids.to(self.device)
+            except Exception:
+                prompt_tensor = None
+
+        gen_kwargs: dict = {
+            "language": self.language,
+            "task": self.task,
+            "do_sample": False,
+            "num_beams": self.num_beams,
+            "repetition_penalty": self.repetition_penalty,
+        }
+        if prompt_tensor is not None:
+            gen_kwargs["prompt_ids"] = prompt_tensor
+
+        for i in range(0, len(audio_paths), batch_size):
+            t0 = time.perf_counter()
+            batch_paths = audio_paths[i : i + batch_size]
+            waveforms = [load_wav_16k(p, target_sr=16000)[0] for p in batch_paths]
+
+            inputs = self.processor(
+                waveforms,
+                sampling_rate=16000,
+                return_tensors="pt",
+            )
+            input_features = inputs.input_features.to(self.device, dtype=self.torch_dtype)
+
+            with torch.inference_mode():
+                predicted_ids = self.model.generate(input_features, **gen_kwargs)
+
+            raw_texts = self.processor.batch_decode(predicted_ids, skip_special_tokens=True)
+            batch_lat = (time.perf_counter() - t0) / max(1, len(batch_paths))
+
+            for raw_text in raw_texts:
+                clean_text = strip_asr_tags(raw_text)
+                clean_text = unicodedata.normalize("NFC", clean_text).strip()
+                if self.enable_itn:
+                    from src.asr.itn import inverse_text_normalize
+
+                    clean_text = inverse_text_normalize(clean_text)
+                results.append(
+                    ASRResult(
+                        text=clean_text,
+                        raw_text=raw_text,
+                        latency_s=batch_lat,
+                    )
+                )
+
+        return results
