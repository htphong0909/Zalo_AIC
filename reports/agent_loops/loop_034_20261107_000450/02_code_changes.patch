+                if m:
+                    punc = m.group(1)
+                replacement = c_span_raw[0]
+                if orig_w and orig_w[0].isupper():
+                    replacement = replacement.capitalize()
+                refined_words[i1] = replacement + punc
+                continue
+
+        # If span contains protected entity, STRICT IMMUNITY: never replace or delete!
+        if span_has_entity:
