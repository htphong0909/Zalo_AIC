+    # 3. Known domain entities
+    if clean.lower() in DOMAIN_ENTITIES:
+        return True
+    # 4. Mid-sentence uppercase (proper nouns like Lê Minh, Lan, Bố, Đà Lạt)
+    if idx > 0 and clean[0].isupper() and clean.lower() not in VI_PARTICLES:
+        return True
+    return False
