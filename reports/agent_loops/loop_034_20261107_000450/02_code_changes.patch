+def _is_entity(word: str, idx: int) -> bool:
+    """Detects whether a token is an entity requiring strict immunity."""
+    clean = _strip_punct(word)
+    if not clean:
+        return False
+    # 1. Contains digits
+    if re.search(r"\d", clean):
+        return True
+    # 2. All-caps acronym (len >= 2)
+    if len(clean) >= 2 and clean.isupper():
